---
name: Ansible Apply

# Real run. Needs a successful Ansible Check run from the last 24 hours on the same commit with the same inputs, and a typed confirmation.
run-name: "Apply ${{ inputs.environment }} | ${{ inputs.playbook }} | limit=${{ inputs.limit }} | tags=${{ inputs.tags }} | skip=${{ inputs.skip_tags }}"

on:
  workflow_dispatch:
    inputs:
      environment:
        description: Target environment
        type: choice
        options: @@environments_flow@@
        required: true
      playbook:
        description: Playbook path under playbooks/
        type: string
        default: playbooks/site.yml
        required: true
      limit:
        description: Host limit (--limit), empty for all hosts
        type: string
        default: ""
      tags:
        description: Run only these tags, comma-separated
        type: string
        default: ""
      skip_tags:
        description: Skip these tags, comma-separated
        type: string
        default: ""
      check_run_id:
        description: Run id of the successful Ansible Check run you reviewed
        type: string
        required: true
      confirm_apply:
        description: Type apply-<environment>, for example apply-production
        type: string
        required: true

permissions:
  contents: read

concurrency:
  group: ansible-${{ inputs.environment }}
  cancel-in-progress: false

jobs:
  apply:
    name: "Apply ${{ inputs.environment }}"
    runs-on: ubuntu-latest
    timeout-minutes: 60
    environment: ${{ inputs.environment }}
    permissions:
      contents: read
      actions: read
      @@job_permissions@@
    steps:
      - name: Verify the confirmation and the reviewed check run
        shell: bash
        run: |
          set -euo pipefail
          if [ "${CONFIRM_APPLY}" != "apply-${ENVIRONMENT}" ]; then
            echo "error: confirm_apply must be exactly apply-${ENVIRONMENT}" >&2
            exit 1
          fi
          if [[ ! "${CHECK_RUN_ID}" =~ ^[0-9]+$ ]]; then
            echo "error: check_run_id must be a number" >&2
            exit 1
          fi
          run="$(gh run view "${CHECK_RUN_ID}" --repo "${GITHUB_REPOSITORY}" --json conclusion,headSha,workflowName,displayTitle,createdAt)"
          expected="Check ${ENVIRONMENT} | ${PLAYBOOK} | limit=${LIMIT} | tags=${TAGS} | skip=${SKIP_TAGS}"
          [ "$(jq -r .workflowName <<<"${run}")" = "Ansible Check" ] || { echo "error: run ${CHECK_RUN_ID} is not an Ansible Check run" >&2; exit 1; }
          [ "$(jq -r .conclusion <<<"${run}")" = "success" ] || { echo "error: check run ${CHECK_RUN_ID} did not succeed" >&2; exit 1; }
          [ "$(jq -r .headSha <<<"${run}")" = "${GITHUB_SHA}" ] || { echo "error: check run ${CHECK_RUN_ID} used another commit" >&2; exit 1; }
          created="$(date -d "$(jq -r .createdAt <<<"${run}")" +%s)"
          [ $(( $(date +%s) - created )) -lt 86400 ] || { echo "error: check run ${CHECK_RUN_ID} is older than 24 hours. Run Ansible Check again" >&2; exit 1; }
          [ "$(jq -r .displayTitle <<<"${run}")" = "${expected}" ] || { echo "error: check run ${CHECK_RUN_ID} used other inputs than this apply" >&2; exit 1; }
        env:
          GH_TOKEN: ${{ github.token }}
          CONFIRM_APPLY: ${{ inputs.confirm_apply }}
          CHECK_RUN_ID: ${{ inputs.check_run_id }}
          ENVIRONMENT: ${{ inputs.environment }}
          PLAYBOOK: ${{ inputs.playbook }}
          LIMIT: ${{ inputs.limit }}
          TAGS: ${{ inputs.tags }}
          SKIP_TAGS: ${{ inputs.skip_tags }}

      - name: Checkout repository
        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false

      - name: Set up Ansible
        uses: ./.github/actions/setup-ansible
        with:
          vault-password: ${{ secrets.ANSIBLE_VAULT_PASSWORD }}
          environment: ${{ inputs.environment }}

      @@auth_steps@@

      - name: Apply
        run: scripts/run-playbook.sh
        shell: bash
        env:
          MODE: apply
          ENVIRONMENT: ${{ inputs.environment }}
          PLAYBOOK: ${{ inputs.playbook }}
          LIMIT: ${{ inputs.limit }}
          TAGS: ${{ inputs.tags }}
          SKIP_TAGS: ${{ inputs.skip_tags }}

      - name: Remove secrets from the runner
        if: always()
        shell: bash
        run: rm -rf "${HOME}/.vault" "${HOME}/.ssh/id_ed25519"
