---
extends: default

ignore: |
  .ansible/
  .venv/
  inventories/*/group_vars/**/vault.yml

rules:
  braces:
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  document-start:
    present: true
  indentation:
    spaces: 2
    indent-sequences: true
  line-length:
    max: 160
    level: warning
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false # GitHub workflows use the key "on"
